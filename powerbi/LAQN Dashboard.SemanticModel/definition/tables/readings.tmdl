table readings
	lineageTag: 109576d3-8da0-43f5-86d9-8acf29616390

	measure 'Avg AQI (Latest)' =
			
			AVERAGEX ( VALUES ( sites[site_code] ), [Latest AQI] )
		lineageTag: 69dc1ad5-de28-45dc-ac55-3722e391dc4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_AQI_of_London =
			
			CALCULATE(
			    AVERAGE('readings'[aq_index] ),
			    FILTER('readings', 'readings'[aq_index] <> 0 ))
		lineageTag: e28d6875-7bac-4968-a260-689f966911eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

