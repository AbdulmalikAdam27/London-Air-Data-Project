	partition readings = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/AbdulmalikAdam27/London-Air-Data-Project/main/data/readings.csv"),[Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ToUtc = (t as nullable text) as nullable datetime => if t = null or t = "" then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), 0)),
				    #"Parsed UTC times" = Table.TransformColumns(#"Promoted Headers", {{"fetched_at_utc", ToUtc, type datetime}, {"data_end_parsed", ToUtc, type datetime}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Parsed UTC times",{{"ttl_minutes", type text}, {"local_authority", type text}, {"site_code", type text}, {"site_name", type text}, {"site_type", type text}, {"species_code", type text}, {"species_name", type text}, {"aq_index", type number}, {"aq_band", type text}, {"index_source", type text}, {"data_end", type datetime}}),
				    #"Removed legacy rows" = Table.SelectRows(#"Changed Type", each [data_end_parsed] <> null and [data_end_parsed] >= #datetime(2026, 9, 1, 0, 0, 0))
				in
				    #"Removed legacy rows"

	annotation PBI_NavigationStepName = Navigation

