	column 'Reading Date' = IF ( ISBLANK ( readings[data_end_parsed] ), BLANK (), DATE ( YEAR ( readings[data_end_parsed] ), MONTH ( readings[data_end_parsed] ), DAY ( readings[data_end_parsed] ) ) )
		dataType: dateTime
