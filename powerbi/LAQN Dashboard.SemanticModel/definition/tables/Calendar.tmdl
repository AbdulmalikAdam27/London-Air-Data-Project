	column 'Days Ago'
		dataType: int64
		formatString: 0
		lineageTag: 65117a93-5620-4b1d-9a08-d7c7f53706fd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Days Ago]

		annotation SummarizationSetBy = Automatic

	column 'Day Label'
		dataType: string
		lineageTag: ebfef3ec-a3ff-43fd-af20-42b30086a5e1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Label]
		sortByColumn: Date

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				VAR d0 = MIN ( readings[Reading Date] )
				VAR d1 = MAX ( readings[Reading Date] )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( d0, d1 ),
				        "Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
				        "Week Label", FORMAT ( [Date] - WEEKDAY ( [Date], 2 ) + 1, "dd mmm" ),
				        "Weekday No", WEEKDAY ( [Date], 2 ),
				        "Weekday", FORMAT ( [Date], "ddd" ),
				        "Days Ago", INT ( d1 - [Date] ),
				        "Day Label", FORMAT ( [Date], "dd mmm" )
				    )

